		<properties node_id="26" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02$\x00\x00\x00\xc8\x00\x00\x06W\x00\x00\x04:\x00\x00\x02$\x00\x00\x00\xc8\x00\x00\x05G\x00\x00\x03\x1f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x02$\x00\x00\x00\xc8\x00\x00\x06W\x00\x00\x04:', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'from Orange.data import Table, Domain, DiscreteVariable\nfrom Orange.classification import Learner, Model\nimport numpy as np\nfrom sklearn.tree import DecisionTreeClassifier\n\n# Отримуємо дані\nX = in_data.X\ny = in_data.Y.flatten()\n\n# Створюємо власний sklearn-класифікатор\nclf = DecisionTreeClassifier(max_depth=3)\nclf.fit(X, y)\n\n# Обгортка для Orange\nclass MyModel(Model):\n    def __init__(self, sk_model):\n        self.sk_model = sk_model\n        \n    def __call__(self, X):\n        preds = self.sk_model.predict(X)\n        # Orange очікує shape (n_samples, n_classes)\n        if len(np.unique(y)) == 2:\n            # для бінарного випадку\n            probs = np.zeros((X.shape[0], 2))\n            probs[np.arange(X.shape[0]), preds] = 1.0\n        else:\n            n_classes = len(np.unique(y))\n            probs = np.zeros((X.shape[0], n_classes))\n            probs[np.arange(X.shape[0]), preds] = 1.0\n        return probs\n\nclass MyLearner(Learner):\n    def __init__(self, sk_model):\n        super().__init__()\n        self.sk_model = sk_model\n\n    def fit(self, data):\n        return MyModel(self.sk_model)\n\n# Підключаємо свій класифікатор\nout_learner = MyLearner(clf)\n', 'filename': None}], 'scriptText': "from Orange.data import Table\nfrom Orange.classification import Learner, Model\nimport numpy as np\nfrom sklearn.tree import DecisionTreeClassifier\n\nclass MyModel(Model):\n    def __init__(self, sk_model, domain):\n        super().__init__(domain)\n        self.sk_model = sk_model\n    \n    def predict(self, X):\n        # X вже є numpy array\n        if isinstance(X, Table):\n            X = X.X\n        preds = self.sk_model.predict(X)\n        return preds\n    \n    def predict_proba(self, X):\n        # X вже є numpy array або Table\n        if isinstance(X, Table):\n            X = X.X\n        \n        # Якщо модель підтримує predict_proba\n        if hasattr(self.sk_model, 'predict_proba'):\n            return self.sk_model.predict_proba(X)\n        else:\n            # Інакше створюємо one-hot encoded probabilities\n            preds = self.sk_model.predict(X)\n            n_classes = len(self.domain.class_var.values)\n            probs = np.zeros((X.shape[0], n_classes))\n            probs[np.arange(X.shape[0]), preds.astype(int)] = 1.0\n            return probs\n    \n    def __call__(self, data, ret=Model.Value):\n        # Orange викликає модель з параметром ret\n        if isinstance(data, Table):\n            X = data.X\n        else:\n            X = np.atleast_2d(data)\n        \n        if ret == Model.Value:\n            return self.predict(X)\n        elif ret == Model.Probs:\n            return self.predict_proba(X)\n        else:  # Model.ValueProbs\n            return self.predict(X), self.predict_proba(X)\n\nclass MyLearner(Learner):\n    name = 'My Decision Tree'\n    \n    def __init__(self, max_depth=3):\n        super().__init__()\n        self.max_depth = max_depth\n        self.params = {}\n    \n    def fit_storage(self, data):\n        # Orange викликає fit_storage замість fit\n        X = data.X\n        y = data.Y.flatten().astype(int)\n        \n        # Створюємо та тренуємо sklearn модель\n        clf = DecisionTreeClassifier(max_depth=self.max_depth, random_state=42)\n        clf.fit(X, y)\n        \n        # Повертаємо нашу модель з доменом даних\n        return MyModel(clf, data.domain)\n\n# Створюємо learner (не тренуємо тут!)\n# Orange сам викличе fit_storage коли потрібно\nout_learner = MyLearner(max_depth=3)\n", 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa7\x00\x00\x00e\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
	</node_properties>
