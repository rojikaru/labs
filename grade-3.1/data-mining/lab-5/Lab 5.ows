		<properties node_id="14" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02$\x00\x00\x00\xc8\x00\x00\t\x8b\x00\x00\x04\xb2\x00\x00\x02$\x00\x00\x00\xc8\x00\x00\x05\xe3\x00\x00\x04\xe5\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x02$\x00\x00\x00\xc8\x00\x00\t\x8b\x00\x00\x04\xb2', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable\n\npred = in_object.predicted  # shape: (n_models, n_instances)\n\n# If you have model names\ntry:\n    model_names = [str(l) for l in in_object.learners]  # or in_object.models\nexcept AttributeError:\n    model_names = [f"Model {i}" for i in range(pred.shape[0])]\n\n# Variance per model (over all instances)\nvar_per_model = np.var(pred, axis=1)\nvar_dict = {name: var for name, var in zip(model_names, var_per_model)}\n\nprint("Variance per model:")\nfor name, var in var_dict.items():\n    print(f"  {name}: {var:.6f}")\n\n# Variance across models for each instance\nvar_across_models = np.var(pred, axis=0)\nmean_var = np.mean(var_across_models)\nprint(f"\\nMean variance across models (per instance): {mean_var:.6f}")\n\n# Step 1: create variables\nvariables = [ContinuousVariable(name) for name in var_dict.keys()]\n\n# Step 2: create domain\ndomain = Domain(variables)\n\n# Step 3: convert dict values to a 2D array (rows × columns)\nvalues = np.array([np.append(var_per_model, [mean_var])])  # single row here\n\n# Step 4: construct Table\nout_data = Table(domain, values)\nprint(out_data)', 'filename': None}], 'scriptText': 'import numpy as np\nfrom collections import Counter\nimport Orange\n\npred = np.array(in_object.predicted)  # shape (n_models, n_instances)\nn_models, n_instances = pred.shape\nk_classes = int(pred.max() - pred.min() + 1)  # e.g. 5\n\n# ensure integer labels if they are floats encoding classes\npred_int = pred.astype(int)\n\n# per-model variance across instances\nvar_per_model = np.var(pred_int, axis=1)           # ddof=0 by default\nnorm_var_per_model = var_per_model / 4.0           # 4 = theoretical max for labels 0..4\n\n# per-instance variance across models\nvar_per_instance = np.var(pred_int, axis=0)\nmean_var_across_instances = var_per_instance.mean()\nnorm_mean_var_across_instances = mean_var_across_instances / 4.0\n\n# class counts per model\ncounts_per_model = [Counter(row) for row in pred_int]\n\n# entropy per-instance of vote distribution (base k to normalize 0..1)\ndef vote_entropy(votes, k=k_classes):\n    counts = np.array(list(Counter(votes).values()), dtype=float)\n    probs = counts / counts.sum()\n    # guard against zeros\n    ent = -np.sum(p * np.log(p) for p in probs if p &gt; 0)\n    # normalized entropy (divide by log(k))\n    return ent / np.log(k)\n\nentropies = np.array([vote_entropy(pred_int[:, j]) for j in range(n_instances)])\nmean_entropy = entropies.mean()\n\n# consensus / agreement stats\nall_agree_count = np.sum([np.all(pred_int[:, j] == pred_int[0, j]) for j in range(n_instances)])\n# better: majority size fraction\nmajority_sizes = np.array([Counter(pred_int[:, j]).most_common(1)[0][1] for j in range(n_instances)])\nmean_majority_fraction = majority_sizes.mean() / n_models\n\n# print results\nprint("n_models, n_instances:", n_models, n_instances)\nprint("Models: ", in_object.learner_names)\nprint("Var per model:", var_per_model)\nprint("Normalized var per model ( /4):", norm_var_per_model)\nprint("Mean var across models (per instance):", mean_var_across_instances,\n      " normalized:", norm_mean_var_across_instances)\nprint("Mean vote entropy (0..1):", mean_entropy)\nprint("All-models-agree fraction:", all_agree_count / n_instances)\nprint("Mean majority fraction:", mean_majority_fraction)\n\n\npred = np.array(in_object.predicted).astype(float)  # shape (n_models, n_instances)\ny_true = np.array(in_object.actual)          # shape (n_instances,)\n\n# Expected prediction per instance (mean over models)\ny_mean = pred.mean(axis=0)  # shape (n_instances,)\n\n# Bias^2 per instance\nbias_sq_per_instance = (y_mean - y_true) ** 2\n\n# Mean bias^2 over all instances\nmean_bias_sq = bias_sq_per_instance.mean()\n\n# Root bias for interpretability\nroot_bias = np.sqrt(mean_bias_sq)\n\nprint("Mean squared bias:", mean_bias_sq)\nprint("Root bias:", root_bias)\n\n# ---- Metrics from your script ----\nmodel_names = in_object.learner_names\n\nmetrics = {\n    "Var per model": var_per_model,\n    "Normalized var per model": norm_var_per_model,\n    "Mean var across instances": [mean_var_across_instances]*n_models,\n    "Norm mean var across instances": [norm_mean_var_across_instances]*n_models,\n    "Mean vote entropy": [mean_entropy]*n_models,\n    "All-models-agree fraction": [all_agree_count / n_instances]*n_models,\n    "Mean majority fraction": [mean_majority_fraction]*n_models,\n    "Mean squared bias": [mean_bias_sq]*n_models,\n    "Root bias": [root_bias]*n_models\n}\n\n# ---- Construct Orange Table ----\ndomain = Orange.data.Domain(\n    [Orange.data.ContinuousVariable(name) for name in metrics.keys()],\n    class_vars=[Orange.data.DiscreteVariable("Model", values=model_names)]\n)\n\n# create rows: each row = one model, metrics + model name as class\nrows = []\nfor i, model in enumerate(model_names):\n    row = [metrics[key][i] for key in metrics] + [model]\n    rows.append(row)\n\nout_object = Orange.data.Table.from_list(domain, rows)\n\nprint("out_object ready for bar plot!")\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa7\x00\x00\x00e\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
