<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_IncidentResponse" targetNamespace="http://trafix.company.inc/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.1">
  <message id="msg_incident_detected" name="IncidentDetected" />
  <message id="msg_escalation_notice" name="EscalationNotice" />
  <message id="msg_incident_closed" name="IncidentClosed" />
  <message id="msg_field_command" name="FieldDeviceCommand" />
  <message id="msg_field_ack" name="FieldDeviceAcknowledgement" />
  <collaboration id="Collab_IncidentResponse">
    <participant id="Pool_System" name="Traffic Management Service" processRef="Proc_System" />
    <participant id="Pool_Regular" name="Dispatcher System Portal" processRef="Proc_Regular" />
    <participant id="Pool_Senior" name="Senior Operator System" processRef="Proc_Senior" />
    <participant id="Pool_Field" name="Field Devices (Traffic Controllers)" processRef="Proc_Field" />
    <messageFlow id="mf_detect_to_dispatcher" sourceRef="Task_SystemDetect" targetRef="StartEvent_Dispatcher" />
    <messageFlow id="mf_dispatcher_cmd" name="Device command" sourceRef="Task_SendCommand" targetRef="StartEvent_Field" />
    <messageFlow id="mf_field_ack" name="Command ACK (≤1 s)" sourceRef="Activity_1cp97b5" targetRef="BndEvt_CmdAck" />
    <messageFlow id="mf_escalate" name="Escalation Notice" sourceRef="Task_EscalateToSenior" targetRef="StartEvent_Senior" />
  </collaboration>
  <process id="Proc_System" name="System" isExecutable="false">
    <startEvent id="Start_System" name="Sensor data&#10;received">
      <outgoing>sf_sys_1</outgoing>
    </startEvent>
    <task id="Task_Collect" name="Collect &#38; analyse&#10;traffic data">
      <incoming>sf_sys_1</incoming>
      <outgoing>sf_sys_2</outgoing>
    </task>
    <exclusiveGateway id="GW_Anomaly" name="Anomaly&#10;detected?">
      <incoming>sf_sys_2</incoming>
      <outgoing>sf_sys_yes</outgoing>
      <outgoing>sf_sys_no</outgoing>
    </exclusiveGateway>
    <task id="Task_ContinueMonitor" name="Continue&#10;monitoring loop">
      <incoming>sf_sys_no</incoming>
      <outgoing>sf_sys_loop</outgoing>
    </task>
    <task id="Task_Classify" name="Classify incident&#10;priority P1/P2/P3">
      <incoming>sf_sys_yes</incoming>
      <outgoing>sf_sys_3</outgoing>
    </task>
    <sendTask id="Task_SystemDetect" name="Push alert to&#10;dispatcher portal">
      <incoming>sf_sys_3</incoming>
    </sendTask>
    <sequenceFlow id="sf_sys_1" sourceRef="Start_System" targetRef="Task_Collect" />
    <sequenceFlow id="sf_sys_2" sourceRef="Task_Collect" targetRef="GW_Anomaly" />
    <sequenceFlow id="sf_sys_yes" name="Yes" sourceRef="GW_Anomaly" targetRef="Task_Classify" />
    <sequenceFlow id="sf_sys_no" name="No" sourceRef="GW_Anomaly" targetRef="Task_ContinueMonitor" />
    <sequenceFlow id="sf_sys_loop" sourceRef="Task_ContinueMonitor" targetRef="End_System" />
    <sequenceFlow id="sf_sys_3" sourceRef="Task_Classify" targetRef="Task_SystemDetect" />
    <sequenceFlow id="sf_sys_4" sourceRef="Event_1l7tdwv" targetRef="Gateway_05cp65l" />
    <exclusiveGateway id="Gateway_05cp65l" name="Input received?">
      <incoming>sf_sys_4</incoming>
      <outgoing>Flow_1tjkews</outgoing>
      <outgoing>Flow_0d01jap</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_1tjkews" name="Yes" sourceRef="Gateway_05cp65l" targetRef="End_System" />
    <endEvent id="End_System" name="Monitoring&#10;continues">
      <incoming>sf_sys_loop</incoming>
      <incoming>Flow_1tjkews</incoming>
      <incoming>Flow_027kniv</incoming>
    </endEvent>
    <startEvent id="Event_1l7tdwv" name="Initialize 60s&#10;inactivity timer">
      <outgoing>sf_sys_4</outgoing>
      <timerEventDefinition id="TimerEventDefinition_1vb9l1z" />
    </startEvent>
    <sequenceFlow id="Flow_0d01jap" sourceRef="Gateway_05cp65l" targetRef="Task_EscalateToSenior" />
    <sendTask id="Task_EscalateToSenior" name="Trigger automated&#10;senior escalation">
      <incoming>Flow_0d01jap</incoming>
      <outgoing>Flow_027kniv</outgoing>
    </sendTask>
    <sequenceFlow id="Flow_027kniv" sourceRef="Task_EscalateToSenior" targetRef="End_System" />
  </process>
  <process id="Proc_Regular" name="Dispatcher System Portal" isExecutable="false">
    <inclusiveGateway id="GW_Split_Parallel">
      <incoming>sf_d2</incoming>
      <outgoing>sf_d_cam</outgoing>
      <outgoing>sf_d_cmd</outgoing>
    </inclusiveGateway>
    <task id="Task_ReviewCamera" name="Stream requested&#10;live feed">
      <incoming>sf_d_cam</incoming>
      <outgoing>sf_d_cam_done</outgoing>
    </task>
    <sendTask id="Task_SendCommand" name="Dispatch hardware&#10;command (signal/sign)">
      <incoming>sf_d_cmd</incoming>
      <outgoing>sf_d_wait_ack</outgoing>
    </sendTask>
    <startEvent id="StartEvent_Dispatcher" name="Incident alert&#10;received">
      <outgoing>sf_d1</outgoing>
      <messageEventDefinition messageRef="msg_incident_detected" />
    </startEvent>
    <task id="Task_AssessSituation" name="Render map &#38;&#10;camera streams">
      <incoming>sf_d1</incoming>
      <incoming>Flow_035f5kv</incoming>
      <outgoing>sf_d2</outgoing>
    </task>
    <endEvent id="End_IncidentClosed" name="Incident closed&#10;&#38; logged">
      <incoming>sf_d_closed</incoming>
      <messageEventDefinition messageRef="msg_incident_closed" />
    </endEvent>
    <inclusiveGateway id="GW_Join_Parallel">
      <incoming>sf_d_cam_done</incoming>
      <incoming>sf_d_ack</incoming>
      <incoming>sf_d_wait_ack</incoming>
      <outgoing>Flow_16o0oh0</outgoing>
    </inclusiveGateway>
    <exclusiveGateway id="GW_Resolved" name="Resolution&#10;confirmed?">
      <incoming>Flow_0jk3wat</incoming>
      <outgoing>sf_d_yes_resolved</outgoing>
      <outgoing>Flow_035f5kv</outgoing>
    </exclusiveGateway>
    <task id="Activity_00hzlsw" name="Update admin panel status">
      <incoming>Flow_16o0oh0</incoming>
      <outgoing>Flow_0jk3wat</outgoing>
    </task>
    <transaction id="Task_CloseIncident" name="Execute closure&#10;transaction">
      <incoming>sf_d_yes_resolved</incoming>
      <outgoing>sf_d_closed</outgoing>
      <startEvent id="Start_TxClose" name="Start close">
        <outgoing>sf_tx1</outgoing>
      </startEvent>
      <task id="Task_VerifyClose" name="Prompt visual&#10;verification">
        <incoming>sf_tx1</incoming>
        <outgoing>sf_tx2</outgoing>
      </task>
      <task id="Task_WriteJournal" name="Commit immutable log&#10;(time, actions, actors)">
        <incoming>sf_tx2</incoming>
        <outgoing>sf_tx3</outgoing>
      </task>
      <endEvent id="End_TxClose" name="Committed">
        <incoming>sf_tx3</incoming>
      </endEvent>
      <sequenceFlow id="sf_tx1" sourceRef="Start_TxClose" targetRef="Task_VerifyClose" />
      <sequenceFlow id="sf_tx2" sourceRef="Task_VerifyClose" targetRef="Task_WriteJournal" />
      <sequenceFlow id="sf_tx3" sourceRef="Task_WriteJournal" targetRef="End_TxClose" />
    </transaction>
    <boundaryEvent id="BndEvt_CmdAck" name="ACK&#10;received (≤1s)" attachedToRef="Task_SendCommand">
      <outgoing>sf_d_ack</outgoing>
      <messageEventDefinition messageRef="msg_field_ack" />
    </boundaryEvent>
    <sequenceFlow id="sf_d2" sourceRef="Task_AssessSituation" targetRef="GW_Split_Parallel" />
    <sequenceFlow id="sf_d_cam" sourceRef="GW_Split_Parallel" targetRef="Task_ReviewCamera" />
    <sequenceFlow id="sf_d_cmd" sourceRef="GW_Split_Parallel" targetRef="Task_SendCommand" />
    <sequenceFlow id="sf_d_cam_done" sourceRef="Task_ReviewCamera" targetRef="GW_Join_Parallel" />
    <sequenceFlow id="sf_d_wait_ack" sourceRef="Task_SendCommand" targetRef="GW_Join_Parallel" />
    <sequenceFlow id="sf_d1" sourceRef="StartEvent_Dispatcher" targetRef="Task_AssessSituation" />
    <sequenceFlow id="Flow_035f5kv" name="No" sourceRef="GW_Resolved" targetRef="Task_AssessSituation" />
    <sequenceFlow id="sf_d_closed" sourceRef="Task_CloseIncident" targetRef="End_IncidentClosed" />
    <sequenceFlow id="sf_d_ack" sourceRef="BndEvt_CmdAck" targetRef="GW_Join_Parallel" />
    <sequenceFlow id="Flow_16o0oh0" sourceRef="GW_Join_Parallel" targetRef="Activity_00hzlsw" />
    <sequenceFlow id="Flow_0jk3wat" sourceRef="Activity_00hzlsw" targetRef="GW_Resolved" />
    <sequenceFlow id="sf_d_yes_resolved" name="Yes" sourceRef="GW_Resolved" targetRef="Task_CloseIncident" />
  </process>
  <process id="Proc_Senior" name="Senior Operator System" isExecutable="false">
    <startEvent id="StartEvent_Senior" name="Escalation&#10;notice received">
      <outgoing>Flow_0yvfg58</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0yjfho7" messageRef="msg_escalation_notice" />
    </startEvent>
    <subProcess id="SubProc_SeniorHandling" name="Senior operator&#10;incident handling">
      <incoming>Flow_0yvfg58</incoming>
      <outgoing>Flow_0pwt2nx</outgoing>
      <startEvent id="Start_Sub" name="Start">
        <outgoing>sf_sub1</outgoing>
      </startEvent>
      <task id="Task_Senior_Assess" name="Render full city&#10;dashboard">
        <incoming>sf_sub1</incoming>
        <outgoing>sf_sub2</outgoing>
      </task>
      <callActivity id="CallAct_ManualControl" name="Provide manual&#10;override API" calledElement="Proc_ManualControl">
        <incoming>sf_sub2</incoming>
        <outgoing>sf_sub3</outgoing>
      </callActivity>
      <task id="Task_Senior_Confirm" name="Process resolution&#10;override">
        <incoming>sf_sub3</incoming>
        <outgoing>Flow_0ccsv1t</outgoing>
      </task>
      <sequenceFlow id="sf_sub1" sourceRef="Start_Sub" targetRef="Task_Senior_Assess" />
      <sequenceFlow id="sf_sub2" sourceRef="Task_Senior_Assess" targetRef="CallAct_ManualControl" />
      <sequenceFlow id="sf_sub3" sourceRef="CallAct_ManualControl" targetRef="Task_Senior_Confirm" />
      <sendTask id="Activity_000ck8r" name="Broadcast resolution&#10;state">
        <incoming>Flow_0ccsv1t</incoming>
      </sendTask>
      <sequenceFlow id="Flow_0ccsv1t" sourceRef="Task_Senior_Confirm" targetRef="Activity_000ck8r" />
    </subProcess>
    <sequenceFlow id="Flow_0yvfg58" sourceRef="StartEvent_Senior" targetRef="SubProc_SeniorHandling" />
    <endEvent id="Event_04xxu7j" name="Incident closed&#10;&#38; logged">
      <incoming>Flow_0pwt2nx</incoming>
      <messageEventDefinition id="MessageEventDefinition_0b2p8w6" messageRef="msg_incident_closed" />
    </endEvent>
    <sequenceFlow id="Flow_0pwt2nx" sourceRef="SubProc_SeniorHandling" targetRef="Event_04xxu7j" />
  </process>
  <process id="Proc_Field" name="Field Devices" isExecutable="false">
    <startEvent id="StartEvent_Field" name="Command&#10;received">
      <outgoing>sf_f1</outgoing>
      <messageEventDefinition messageRef="msg_field_command" />
    </startEvent>
    <task id="Task_FieldValidate" name="Validate command&#10;(auth check)">
      <incoming>sf_f1</incoming>
      <outgoing>sf_f2</outgoing>
    </task>
    <exclusiveGateway id="GW_FieldAuth" name="Authorised?&#10;(region, role)">
      <incoming>sf_f2</incoming>
      <outgoing>sf_f_ok</outgoing>
      <outgoing>sf_f_deny</outgoing>
    </exclusiveGateway>
    <task id="Task_FieldExecute" name="Execute signal change">
      <incoming>sf_f_ok</incoming>
      <outgoing>Flow_1cavqde</outgoing>
    </task>
    <endEvent id="End_Field_Denied" name="Command rejected">
      <incoming>sf_f_deny</incoming>
    </endEvent>
    <sequenceFlow id="sf_f1" sourceRef="StartEvent_Field" targetRef="Task_FieldValidate" />
    <sequenceFlow id="sf_f2" sourceRef="Task_FieldValidate" targetRef="GW_FieldAuth" />
    <sequenceFlow id="sf_f_ok" name="Yes" sourceRef="GW_FieldAuth" targetRef="Task_FieldExecute" />
    <sequenceFlow id="sf_f_deny" name="No" sourceRef="GW_FieldAuth" targetRef="End_Field_Denied" />
    <endEvent id="End_Field_Done" name="Signal changed">
      <incoming>Flow_0wzhizr</incoming>
    </endEvent>
    <sendTask id="Activity_1cp97b5" name="Send ACK">
      <incoming>Flow_1cavqde</incoming>
      <outgoing>Flow_0wzhizr</outgoing>
    </sendTask>
    <sequenceFlow id="Flow_1cavqde" sourceRef="Task_FieldExecute" targetRef="Activity_1cp97b5" />
    <sequenceFlow id="Flow_0wzhizr" sourceRef="Activity_1cp97b5" targetRef="End_Field_Done" />
  </process>
