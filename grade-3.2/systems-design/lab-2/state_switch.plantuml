@startuml
skinparam state {
  BackgroundColor White
  BorderColor Black
  FontName Arial
}

[*] --> Автоматичний_режим : Ініціалізація системи

state "Автоматичний режим" as Автоматичний_режим {
  [*] --> Моніторинг
  Моніторинг --> Прийняття_рішень : Виявлення відхилень
  Прийняття_рішень --> Керування_пристроями
  Керування_пристроями --> Моніторинг
}

state "Ручний режим" as Ручний_режим {
  [*] --> Очікування_команди
  Очікування_команди --> Виконання_команди
  Виконання_команди --> Очікування_команди
}

state "Стандартний режим" as Стандартний_режим {
  [*] --> Звичайна_робота
  note right of Звичайна_робота
    Автономна робота світлофорів 
    без втручання системи керування
  end note
}

state "Безпечне перемикання" as Перехідний_стан {
    [*] --> Сповіщення_у_консолі_диспетчера
    Сповіщення_у_консолі_диспетчера --> [*]: Завершення_сигнального_циклу
}

Автоматичний_режим --> Перехідний_стан : Запит на Ручний режим
Перехідний_стан --> Ручний_режим

Автоматичний_режим --> Стандартний_режим : Запит на Стандартний / Збій
Ручний_режим --> Стандартний_режим : Запит на Стандартний / Збій

Ручний_режим --> Автоматичний_режим : Запит на Автоматичний
Стандартний_режим --> Автоматичний_режим : Відновлення / Запит оператора

@enduml
